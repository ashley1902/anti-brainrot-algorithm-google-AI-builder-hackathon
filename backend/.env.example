# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# DeepSeek API key — get from https://platform.deepseek.com/
DEEPSEEK_API_KEY=mock

# DeepSeek base URL (default shown; change if provider updates it)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek model name — verify availability in your account
DEEPSEEK_MODEL=deepseek-chat

# Port the local development server binds to
PORT=8787

# ─── Security notice ──────────────────────────────────────────────────────────
# This backend is for LOCAL DEVELOPMENT ONLY.
# It has NO authentication, rate limiting, or abuse protection.
# Do NOT expose it on a public network or deploy it as-is.
# For production: add authentication, rate limits, secret management,
# request logging (without raw content), and HTTPS.
