# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Set ONE of the following. GEMINI_API_KEY takes priority if both are set.

# Google Gemini (recommended for Cloud Run deployment)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model
GEMINI_MODEL=gemini-2.0-flash-lite

# DeepSeek (local dev alternative)
# Get from https://platform.deepseek.com/
DEEPSEEK_API_KEY=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─── Server ───────────────────────────────────────────────────────────────────
# Port for local development (Cloud Run overrides this with its own PORT env var)
PORT=8787
